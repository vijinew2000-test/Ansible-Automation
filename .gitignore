# Terraform working directory
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform variable files can contain environment data or secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform plans and crash logs
*.tfplan
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive cloud credential files
*credentials*.json
*service-account*.json

# SSH private keys
*.pem
*.key
id_rsa
id_ed25519
